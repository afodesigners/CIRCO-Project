{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard
  "name": "circo-project",
  "compatibility_date": "2026-11-01",
  // Static site: the landing page in ./Landingpage is served as-is, no Worker script.
  // Tooling files in that folder are excluded via Landingpage/.assetsignore.
  "assets": {
    "directory": "./Landingpage",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
